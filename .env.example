DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kd_website"
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional in development: without these values, same-origin checks follow the actual request host and port.
# Required in production: set the public canonical origin and any additional exact preview origins.
APP_BASE_URL=""
APP_ALLOWED_ORIGINS=""
STORAGE_BUCKET="replace-with-private-object-storage-bucket"
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE="false"
