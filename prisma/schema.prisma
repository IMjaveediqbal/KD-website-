generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONTRIBUTOR
  VALIDATOR
  RESEARCHER
  EXPERT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum ContributionStatus {
  DRAFT
  QUEUED
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CORRECTION
  EXPERT_REVIEW
  VALIDATED
  REJECTED
  DUPLICATE
  ARCHIVED
  REVISION_PENDING
}

enum CuratedRecordKind {
  LEXICAL_ENTRY
  CORPUS_SENTENCE
}

enum CuratedRecordStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum ConsentPurpose {
  AUDIO_RECORDING
  RESEARCH
  MODEL_TRAINING
  DATASET_DISTRIBUTION
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum DatasetReleaseStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  passwordHash      String?
  username          String?             @unique
  displayName       String?
  avatarUrl         String?
  role              Role                @default(CONTRIBUTOR)
  status            UserStatus          @default(ACTIVE)
  emailVerifiedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  profile           Profile?
  contributions     Contribution[]
  validationRecords ValidationRecord[]
  sessions          Session[]
  auditLogs         AuditLog[]          @relation("AuditActor")
  consentEvents     ConsentEvent[]
}

model AdminAccount {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  displayName  String?
  status       AdminStatus   @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  createdCuratedRevisions  CuratedRevision[] @relation("CuratedRevisionAuthor")
  approvedCuratedRevisions CuratedRevision[] @relation("CuratedRevisionApprover")
}

model AdminSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  revokedAt DateTime?
  @@index([adminId, expiresAt])
}

model AdminLoginThrottle {
  id              String   @id @default(cuid())
  identifierHash  String   @unique
  failures        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt
  @@index([windowStartedAt])
}

model AdminAuditLog {
  id         String       @id @default(cuid())
  adminId    String
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                  String?
  preferredUiLanguage  String   @default("en")
  dialect              String?
  region               String?
  district             String?
  village              String?
  languages            Json?
  contributorType      String?
  profileVisibility    Json?
  audioConsent         Boolean  @default(false)
  researchConsent      Boolean  @default(false)
  modelTrainingConsent Boolean  @default(false)
  datasetLicense       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Contribution {
  id                      String              @id @default(cuid())
  clientId                String              @unique
  userId                  String
  user                    User                @relation(fields: [userId], references: [id])
  type                    String
  status                  ContributionStatus  @default(DRAFT)
  title                   String?
  originalText            String?
  normalizedText          String?
  transliteration         String?
  englishTranslation      String?
  urduTranslation         String?
  dialect                 String?
  region                  String?
  sourceType              String?
  sourceDescription       String?
  license                 String?
  aiAssisted              Boolean             @default(false)
  aiAssistanceDescription String?
  submittedAt             DateTime?
  validatedAt             DateTime?
  validatedBy             String?
  rejectionReason         String?
  correctionNote          String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  validationRecords       ValidationRecord[]
  audioItems              AudioItem[]
  curatedEvidence         ContributionEvidence[]
  consentEvents           ConsentEvent[]
  @@index([userId, type, status, createdAt])
  @@index([dialect, region])
  @@index([normalizedText])
}

model AudioItem {
  id              String       @id @default(cuid())
  contributionId  String
  contribution    Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  storageKey      String
  mimeType        String
  durationSeconds Int?
  sizeBytes       BigInt?
  checksum        String?
  storageStatus   String       @default("PENDING")
  createdAt       DateTime     @default(now())
  consentEvents   ConsentEvent[]
  @@index([contributionId])
}

model ValidationRecord {
  id             String       @id @default(cuid())
  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  validatorId    String
  validator      User         @relation(fields: [validatorId], references: [id])
  decision       String
  notes          String?
  createdAt      DateTime     @default(now())
  @@index([contributionId, validatorId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}


model AuthRateLimitBucket {
  id              String   @id
  key             String   @unique
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt
}


/// Stable identity for a curated lexical entry or corpus sentence.
/// Typed, revision-specific content lives in the child revision models.
model CuratedRecord {
  id        String              @id @default(cuid())
  kind      CuratedRecordKind
  status    CuratedRecordStatus @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  revisions CuratedRevision[]
  @@index([kind, status, updatedAt])
}

model CuratedRevision {
  id               String         @id @default(cuid())
  recordId         String
  record           CuratedRecord  @relation(fields: [recordId], references: [id], onDelete: Restrict)
  revisionNumber   Int
  changeReason     String?
  createdByAdminId String?
  createdByAdmin   AdminAccount?  @relation("CuratedRevisionAuthor", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  approvedByAdminId String?
  approvedByAdmin  AdminAccount?  @relation("CuratedRevisionApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  lexicalEntry     LexicalEntryRevision?
  corpusSentence   CorpusSentenceRevision?
  contributionEvidence ContributionEvidence[]
  sourceEvidence   RevisionSourceReference[]
  releaseItems     DatasetReleaseItem[]
  @@unique([recordId, revisionNumber])
  @@index([recordId, createdAt])
  @@index([approvedAt])
}

model LexicalEntryRevision {
  id                 String          @id @default(cuid())
  revisionId         String          @unique
  revision           CuratedRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  headword           String
  normalizedHeadword String?
  script             String?
  languageCode       String?
  dialect            String?
  region             String?
  senses             LexicalSense[]
  @@index([normalizedHeadword])
  @@index([dialect, region])
}

model LexicalSense {
  id                     String               @id @default(cuid())
  lexicalEntryRevisionId String
  lexicalEntryRevision   LexicalEntryRevision @relation(fields: [lexicalEntryRevisionId], references: [id], onDelete: Restrict)
  senseNumber            Int
  meaningEnglish         String?
  meaningUrdu            String?
  meaningKhowar          String?
  partOfSpeech           String?
  usageNotes             String?
  createdAt              DateTime             @default(now())
  @@unique([lexicalEntryRevisionId, senseNumber])
}

model CorpusSentenceRevision {
  id                String          @id @default(cuid())
  revisionId        String          @unique
  revision          CuratedRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  originalText      String
  normalizedText    String?
  transliteration   String?
  englishTranslation String?
  urduTranslation   String?
  dialect           String?
  region            String?
  sourceContext     String?
  @@index([normalizedText])
  @@index([dialect, region])
}

/// Explicit many-to-many link: one submission can support multiple revisions,
/// and each revision can cite multiple independent submissions.
model ContributionEvidence {
  id             String          @id @default(cuid())
  revisionId     String
  revision       CuratedRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  contributionId String
  contribution   Contribution    @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  evidenceRole   String          @default("SUPPORTING")
  notes          String?
  createdAt      DateTime        @default(now())
  @@unique([revisionId, contributionId])
  @@index([contributionId])
}

/// Bibliographic, dictionary, archive, or other external source metadata.
model SourceReference {
  id               String   @id @default(cuid())
  sourceType        String
  title             String
  attribution       String?
  stableReference   String?
  license           String?
  notes             String?
  createdAt         DateTime @default(now())
  revisions         RevisionSourceReference[]
  @@unique([sourceType, stableReference])
}

model RevisionSourceReference {
  id                String          @id @default(cuid())
  revisionId        String
  revision          CuratedRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  sourceReferenceId String
  sourceReference   SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict)
  locator           String?
  notes             String?
  @@unique([revisionId, sourceReferenceId])
  @@index([sourceReferenceId])
}

/// Append-only consent evidence. A new REVOKED event supersedes a prior grant;
/// never update a grant in place or infer consent from Profile booleans.
model ConsentEvent {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  contributionId String?
  contribution   Contribution?  @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  audioItemId    String?
  audioItem      AudioItem?     @relation(fields: [audioItemId], references: [id], onDelete: SetNull)
  purpose        ConsentPurpose
  action         ConsentAction
  scope          String
  policyVersion  String
  occurredAt     DateTime       @default(now())
  @@index([userId, purpose, occurredAt])
  @@index([contributionId, purpose, occurredAt])
  @@index([audioItemId, purpose, occurredAt])
}

model DatasetRelease {
  id            String               @id @default(cuid())
  version       String               @unique
  status        DatasetReleaseStatus @default(DRAFT)
  schemaVersion String
  manifest      Json?
  checksum      String?
  createdAt     DateTime             @default(now())
  publishedAt   DateTime?
  items         DatasetReleaseItem[]
}

model DatasetReleaseItem {
  id         String          @id @default(cuid())
  releaseId  String
  release    DatasetRelease  @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  revisionId String
  revision   CuratedRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now())
  @@unique([releaseId, revisionId])
  @@index([revisionId])
}
